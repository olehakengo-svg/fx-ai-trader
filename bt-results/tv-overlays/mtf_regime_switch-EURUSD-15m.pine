//@version=5
// mtf_regime_switch — EUR_USD 15m base, MTF regime-switching edge探索
//
// Idea (user 2026-06-24):
//   - RANGE regime → mean-reversion: RSI extreme (primary) + MACD-histogram divergence (confirm), counter-trend
//   - TREND regime → trend-following: 15m EMA perfect-order + 1h/4h alignment. MR veto撤廃, ride the trend.
//       (only super-extreme RSI >80 / <20 blocks a with-trend entry — blow-off guard)
//   - Regime trigger = 15m EMA perfect order (8/21/55) AND 1h + 4h EMA-fast>slow agreement
//   - MTF roles: 4h=macro bias, 1h=trend confirm, 15m=signal base, 5m=entry-timing confirm, 1m=micro (optional)
//
// All edge discovery completes in Pine (tv-pine-edge-discovery-framework.md). Python BT = final cross-check only.
// KEY OUTPUT: the Regime table (TREND vs RANGE × N/WR/PF/NetP) tells us which mode carries the edge.
//
strategy("mtf_regime_switch (EURUSD 15m, MTF regime)", overlay=true,
         max_labels_count=500, max_lines_count=500, max_boxes_count=50,
         initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10,
         pyramiding=0, process_orders_on_close=true, calc_on_every_tick=false,
         commission_type=strategy.commission.cash_per_contract, commission_value=0)

// ── EMA / perfect-order inputs ──
ema_fast_len = input.int(8,  "15m EMA fast")
ema_mid_len  = input.int(21, "15m EMA mid")
ema_slow_len = input.int(55, "15m EMA slow")
htf_fast_len = input.int(21, "HTF EMA fast (1h/4h)")
htf_slow_len = input.int(55, "HTF EMA slow (1h/4h)")

// ── Oscillator inputs ──
rsi_len   = input.int(14,  "RSI length")
rsi_os    = input.float(30, "MR oversold (BUY trigger)")
rsi_ob    = input.float(70, "MR overbought (SELL trigger)")
rsi_xhi   = input.float(80, "Trend blow-off block: RSI hi")
rsi_xlo   = input.float(20, "Trend blow-off block: RSI lo")
macd_fast = input.int(12,  "MACD fast")
macd_slow = input.int(26,  "MACD slow")
macd_sig  = input.int(9,   "MACD signal")
div_lb    = input.int(8,   "MACD divergence lookback (bars)")
pull_lb   = input.int(6,   "Trend pullback lookback (bars)")

// ── ATR / exits ──
atr_len  = input.int(14,   "ATR length")
sl_mr    = input.float(1.2, "MR  SL ATR mult", step=0.1)
tp_mr    = input.float(1.5, "MR  TP ATR mult", step=0.1)
sl_tr    = input.float(1.5, "Trend SL ATR mult", step=0.1)
tp_tr    = input.float(2.5, "Trend TP ATR mult", step=0.1)
max_hold = input.int(24,   "Max hold bars (time-stop)")

// ── Mode / filter toggles (ablation) ──
en_mr      = input.bool(true,  "Enable RANGE/MR entries")
en_trend   = input.bool(true,  "Enable TREND entries")
use_5m     = input.bool(true,  "5m turn-confirm filter")
use_1m     = input.bool(false, "1m micro-timing filter")
use_macddiv= input.bool(true,  "Require MACD divergence in MR")

// ── Display toggles ──
show_labels      = input.bool(true,  "Show entry labels")
draw_lines       = input.bool(true,  "Draw entry->exit lines")
draw_exits       = input.bool(true,  "Draw exit markers (W/L)")
show_tbl_summary = input.bool(true,  "Summary table (TV mirror)")
show_tbl_session = input.bool(true,  "Session table")
show_tbl_regime  = input.bool(true,  "Regime table (TREND vs RANGE)")

// ── 15m indicators ──
atrv   = ta.atr(atr_len)
ema_f  = ta.ema(close, ema_fast_len)
ema_m  = ta.ema(close, ema_mid_len)
ema_s  = ta.ema(close, ema_slow_len)
rsiv   = ta.rsi(close, rsi_len)
[macd_line, sig_line, hist] = ta.macd(close, macd_fast, macd_slow, macd_sig)

// ── MTF (no look-ahead). 1h/4h = higher TF bias; 5m/1m = lower TF timing ──
h1_ef = request.security(syminfo.tickerid, "60",  ta.ema(close, htf_fast_len), lookahead=barmerge.lookahead_off)
h1_es = request.security(syminfo.tickerid, "60",  ta.ema(close, htf_slow_len), lookahead=barmerge.lookahead_off)
h4_ef = request.security(syminfo.tickerid, "240", ta.ema(close, htf_fast_len), lookahead=barmerge.lookahead_off)
h4_es = request.security(syminfo.tickerid, "240", ta.ema(close, htf_slow_len), lookahead=barmerge.lookahead_off)
rsi_5m = request.security(syminfo.tickerid, "5", ta.rsi(close, rsi_len), lookahead=barmerge.lookahead_off)
rsi_1m = request.security(syminfo.tickerid, "1", ta.rsi(close, rsi_len), lookahead=barmerge.lookahead_off)

h1_bull = h1_ef > h1_es
h1_bear = h1_ef < h1_es
h4_bull = h4_ef > h4_es
h4_bear = h4_ef < h4_es

// ── Regime detection ──
bull_po = ema_f > ema_m and ema_m > ema_s and close > ema_f
bear_po = ema_f < ema_m and ema_m < ema_s and close < ema_f
aligned_bull = bull_po and h1_bull and h4_bull
aligned_bear = bear_po and h1_bear and h4_bear
in_trend = aligned_bull or aligned_bear
in_range = not in_trend

// ── MACD divergence (crude proxy: price extreme vs hist extreme over lookback) ──
bull_div = low  < low[div_lb]  and hist > hist[div_lb]   // price lower-low, momentum higher-low
bear_div = high > high[div_lb] and hist < hist[div_lb]   // price higher-high, momentum lower-high

// ── Timing confirms ──
buy_5m  = not use_5m or rsi_5m > rsi_5m[1]
sell_5m = not use_5m or rsi_5m < rsi_5m[1]
buy_1m  = not use_1m or rsi_1m > rsi_1m[1]
sell_1m = not use_1m or rsi_1m < rsi_1m[1]
buy_timing  = buy_5m  and buy_1m
sell_timing = sell_5m and sell_1m

// ── RANGE / MR entries (counter-trend, RSI-primary + MACD div confirm) ──
mr_div_buy  = not use_macddiv or bull_div
mr_div_sell = not use_macddiv or bear_div
mr_buy  = en_mr and in_range and rsiv < rsi_os and mr_div_buy  and buy_timing
mr_sell = en_mr and in_range and rsiv > rsi_ob and mr_div_sell and sell_timing

// ── TREND entries (with-trend pullback resume; only super-extreme RSI blocks) ──
recent_dip_buy  = ta.lowest(rsiv,  pull_lb)[1] < 50      // RSI pulled back recently
recent_pop_sell = ta.highest(rsiv, pull_lb)[1] > 50
tr_buy  = en_trend and aligned_bull and close > ema_f and rsiv > rsiv[1] and recent_dip_buy  and rsiv < rsi_xhi and buy_timing
tr_sell = en_trend and aligned_bear and close < ema_f and rsiv < rsiv[1] and recent_pop_sell and rsiv > rsi_xlo and sell_timing

// regime + direction (regime is mutually exclusive: trend entries only in_trend, MR only in_range)
buy_sig  = mr_buy  or tr_buy
sell_sig = mr_sell or tr_sell
is_trend_entry = tr_buy or tr_sell

// ── SL/TP per regime ──
sl_mult = is_trend_entry ? sl_tr : sl_mr
tp_mult = is_trend_entry ? tp_tr : tp_mr
sl_dist = atrv * sl_mult
tp_dist = atrv * tp_mult

// ── Time / session (UTC) ──
h_utc = hour(time, "UTC")
session_id(h) =>
    h < 7 ? 0 : h < 13 ? 1 : h < 22 ? 2 : 3   // 0=Tokyo 1=London 2=NY 3=Off
cur_sess = session_id(h_utc)

// ── Entries (record entry-bar context) ──
var int[] trade_session = array.new<int>()
var int[] trade_regime  = array.new<int>()  // 0 = RANGE/MR, 1 = TREND
var int[] trade_dir     = array.new<int>()  // 1 = BUY, -1 = SELL

if buy_sig and strategy.position_size == 0
    strategy.entry("L", strategy.long)
    strategy.exit("LX", "L", stop=close - sl_dist, limit=close + tp_dist)
    array.push(trade_session, cur_sess)
    array.push(trade_regime, is_trend_entry ? 1 : 0)
    array.push(trade_dir, 1)

if sell_sig and strategy.position_size == 0
    strategy.entry("S", strategy.short)
    strategy.exit("SX", "S", stop=close + sl_dist, limit=close - tp_dist)
    array.push(trade_session, cur_sess)
    array.push(trade_regime, is_trend_entry ? 1 : 0)
    array.push(trade_dir, -1)

// ── Time-stop ──
bars_in_trade = strategy.position_size != 0 ? bar_index - strategy.opentrades.entry_bar_index(strategy.opentrades - 1) : 0
if strategy.position_size != 0 and bars_in_trade >= max_hold
    strategy.close_all(comment="time-stop")

// ── Entry labels ──
if show_labels and buy_sig and strategy.position_size == 0
    txt = (is_trend_entry ? "T-BUY" : "MR-BUY") + " r" + str.tostring(rsiv, "0")
    label.new(bar_index, low, text=txt, color=color.new(color.lime, 20), style=label.style_label_up, textcolor=color.black, size=size.tiny)
if show_labels and sell_sig and strategy.position_size == 0
    txt = (is_trend_entry ? "T-SELL" : "MR-SELL") + " r" + str.tostring(rsiv, "0")
    label.new(bar_index, high, text=txt, color=color.new(color.red, 20), style=label.style_label_down, textcolor=color.white, size=size.tiny)

// ── Regime tint: green=trend-bull, red=trend-bear, none=range ──
bgcolor(aligned_bull ? color.new(color.green, 92) : aligned_bear ? color.new(color.red, 92) : na, title="regime")

// ── Draw closed trades: entry→exit line + W/L marker ──
var int last_drawn = 0
if strategy.closedtrades > last_drawn
    for i = last_drawn to strategy.closedtrades - 1
        eb = strategy.closedtrades.entry_bar_index(i)
        xb = strategy.closedtrades.exit_bar_index(i)
        ep = strategy.closedtrades.entry_price(i)
        xp = strategy.closedtrades.exit_price(i)
        is_win = strategy.closedtrades.profit(i) > 0
        col = is_win ? color.new(color.green, 0) : color.new(color.red, 0)
        if draw_lines
            line.new(eb, ep, xb, xp, color=col, width=2, style=line.style_solid)
        if draw_exits
            label.new(xb, xp, text=(is_win ? "W" : "L"), color=color.new(col, 30), textcolor=color.white, style=label.style_label_left, size=size.tiny)
    last_drawn := strategy.closedtrades

// ── Aggregate at last bar ──
var int[]   sess_n     = array.from(0, 0, 0, 0)
var int[]   sess_wins  = array.from(0, 0, 0, 0)
var float[] sess_gross = array.from(0.0, 0.0, 0.0, 0.0)
var float[] sess_loss  = array.from(0.0, 0.0, 0.0, 0.0)
var float[] sess_net   = array.from(0.0, 0.0, 0.0, 0.0)
// regime × direction: 0=RANGE-BUY 1=RANGE-SELL 2=TREND-BUY 3=TREND-SELL
var int[]   reg_n     = array.from(0, 0, 0, 0)
var int[]   reg_wins  = array.from(0, 0, 0, 0)
var float[] reg_gross = array.from(0.0, 0.0, 0.0, 0.0)
var float[] reg_loss  = array.from(0.0, 0.0, 0.0, 0.0)
var float[] reg_net   = array.from(0.0, 0.0, 0.0, 0.0)

var int agg_idx = 0
n_closed = strategy.closedtrades
if n_closed > agg_idx and array.size(trade_session) >= n_closed
    for i = agg_idx to n_closed - 1
        s_id = array.get(trade_session, i)
        rg   = array.get(trade_regime, i)
        d    = array.get(trade_dir, i)
        prof = strategy.closedtrades.profit(i)
        is_win = prof > 0
        array.set(sess_n, s_id, array.get(sess_n, s_id) + 1)
        array.set(sess_net, s_id, array.get(sess_net, s_id) + prof)
        if is_win
            array.set(sess_wins, s_id, array.get(sess_wins, s_id) + 1)
            array.set(sess_gross, s_id, array.get(sess_gross, s_id) + prof)
        else
            array.set(sess_loss, s_id, array.get(sess_loss, s_id) + math.abs(prof))
        rslot = rg * 2 + (d == 1 ? 0 : 1)
        array.set(reg_n, rslot, array.get(reg_n, rslot) + 1)
        array.set(reg_net, rslot, array.get(reg_net, rslot) + prof)
        if is_win
            array.set(reg_wins, rslot, array.get(reg_wins, rslot) + 1)
            array.set(reg_gross, rslot, array.get(reg_gross, rslot) + prof)
        else
            array.set(reg_loss, rslot, array.get(reg_loss, rslot) + math.abs(prof))
    agg_idx := n_closed

// ── Summary table (TV Strategy Tester mirror) ──
draw_tbl = barstate.islast or barstate.islastconfirmedhistory
if draw_tbl and show_tbl_summary
    var table t = table.new(position.top_left, 2, 9, frame_color=color.gray, frame_width=1, border_color=color.gray, border_width=1)
    n_total = strategy.closedtrades
    net = strategy.netprofit
    gp  = strategy.grossprofit
    abs_gl = math.abs(strategy.grossloss)   // TV returns grossloss positive
    pf = abs_gl > 0 ? gp / abs_gl : (gp > 0 ? 999.0 : 0.0)
    wr = n_total > 0 ? 100.0 * strategy.wintrades / n_total : 0.0
    init_c = strategy.initial_capital
    ret_pct = init_c > 0 ? 100.0 * net / init_c : 0.0
    bg = net > 0 ? color.new(color.green, 85) : net < 0 ? color.new(color.red, 85) : color.new(color.gray, 85)
    table.cell(t, 0, 0, "Metric", bgcolor=color.new(color.gray, 60), text_color=color.white)
    table.cell(t, 1, 0, "Value",  bgcolor=color.new(color.gray, 60), text_color=color.white)
    table.cell(t, 0, 1, "Modes", bgcolor=bg, text_color=color.white)
    table.cell(t, 1, 1, (en_mr ? "MR " : "") + (en_trend ? "TREND" : ""), bgcolor=bg, text_color=color.white)
    table.cell(t, 0, 2, "Total trades", bgcolor=bg, text_color=color.white)
    table.cell(t, 1, 2, str.tostring(n_total), bgcolor=bg, text_color=color.white)
    table.cell(t, 0, 3, "Win / Loss", bgcolor=bg, text_color=color.white)
    table.cell(t, 1, 3, str.tostring(strategy.wintrades) + " / " + str.tostring(strategy.losstrades), bgcolor=bg, text_color=color.white)
    table.cell(t, 0, 4, "Win rate %", bgcolor=bg, text_color=color.white)
    table.cell(t, 1, 4, str.tostring(wr, "0.00"), bgcolor=bg, text_color=color.white)
    table.cell(t, 0, 5, "Profit factor", bgcolor=bg, text_color=color.white)
    table.cell(t, 1, 5, str.tostring(pf, "0.00"), bgcolor=bg, text_color=color.white)
    table.cell(t, 0, 6, "Net profit", bgcolor=bg, text_color=color.white)
    table.cell(t, 1, 6, str.tostring(net, "+0.00;-0.00"), bgcolor=bg, text_color=color.white)
    table.cell(t, 0, 7, "Net %", bgcolor=bg, text_color=color.white)
    table.cell(t, 1, 7, str.tostring(ret_pct, "+0.00;-0.00") + "%", bgcolor=bg, text_color=color.white)
    table.cell(t, 0, 8, "Max DD", bgcolor=bg, text_color=color.white)
    table.cell(t, 1, 8, str.tostring(strategy.max_drawdown, "0.00"), bgcolor=bg, text_color=color.white)

// ── Session table ──
sess_label(id) => id == 0 ? "Tokyo" : id == 1 ? "London" : id == 2 ? "NY" : "Off"
if draw_tbl and show_tbl_session
    var table ts = table.new(position.top_right, 5, 5, frame_color=color.gray, frame_width=1, border_color=color.gray, border_width=1)
    table.cell(ts, 0, 0, "Session", bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(ts, 1, 0, "N",   bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(ts, 2, 0, "WR%", bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(ts, 3, 0, "PF",  bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(ts, 4, 0, "NetP",bgcolor=color.new(color.gray, 70), text_color=color.white)
    for sid = 0 to 3
        n = array.get(sess_n, sid)
        w = array.get(sess_wins, sid)
        gr = array.get(sess_gross, sid)
        ls = array.get(sess_loss, sid)
        np = array.get(sess_net, sid)
        wr = n > 0 ? 100.0 * w / n : 0.0
        pf = ls > 0 ? gr / ls : (gr > 0 ? 999.0 : 0.0)
        row = sid + 1
        rbg = np > 0 ? color.new(color.green, 80) : np < 0 ? color.new(color.red, 80) : color.new(color.gray, 80)
        table.cell(ts, 0, row, sess_label(sid), bgcolor=rbg, text_color=color.white)
        table.cell(ts, 1, row, str.tostring(n), bgcolor=rbg, text_color=color.white)
        table.cell(ts, 2, row, str.tostring(wr, "0.0"), bgcolor=rbg, text_color=color.white)
        table.cell(ts, 3, row, str.tostring(pf, "0.00"), bgcolor=rbg, text_color=color.white)
        table.cell(ts, 4, row, str.tostring(np, "+0.0;-0.0"), bgcolor=rbg, text_color=color.white)

// ── Regime table (THE key output: which mode carries the edge) ──
reg_label(slot) => slot == 0 ? "RANGE BUY" : slot == 1 ? "RANGE SELL" : slot == 2 ? "TREND BUY" : "TREND SELL"
if draw_tbl and show_tbl_regime
    var table tr = table.new(position.bottom_right, 5, 5, frame_color=color.gray, frame_width=1, border_color=color.gray, border_width=1)
    table.cell(tr, 0, 0, "Regime",bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(tr, 1, 0, "N",   bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(tr, 2, 0, "WR%", bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(tr, 3, 0, "PF",  bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(tr, 4, 0, "NetP",bgcolor=color.new(color.gray, 70), text_color=color.white)
    for slot = 0 to 3
        n = array.get(reg_n, slot)
        w = array.get(reg_wins, slot)
        gr = array.get(reg_gross, slot)
        ls = array.get(reg_loss, slot)
        np = array.get(reg_net, slot)
        wr = n > 0 ? 100.0 * w / n : 0.0
        pf = ls > 0 ? gr / ls : (gr > 0 ? 999.0 : 0.0)
        row = slot + 1
        rbg = n < 10 ? color.new(color.gray, 80) : np > 0 ? color.new(color.green, 80) : color.new(color.red, 80)
        table.cell(tr, 0, row, reg_label(slot), bgcolor=rbg, text_color=color.white)
        table.cell(tr, 1, row, str.tostring(n), bgcolor=rbg, text_color=color.white)
        table.cell(tr, 2, row, n > 0 ? str.tostring(wr, "0.0") : "-", bgcolor=rbg, text_color=color.white)
        table.cell(tr, 3, row, str.tostring(pf, "0.00"), bgcolor=rbg, text_color=color.white)
        table.cell(tr, 4, row, str.tostring(np, "+0.0;-0.0"), bgcolor=rbg, text_color=color.white)
