//@version=6
// =====================================================================
// Price-Shock Reversion — AUD_JPY H1 LONG (percentile=1%, horizon=12, vol_q=ALL)
//
// Pre-reg LOCK (commit 35961351, 2026-05-18):
//   - Direction: LONG
//   - Percentile threshold: bottom 1% of log_return over rolling 252 bars
//     (current bar EXCLUDED from window → look-ahead safe)
//   - Vol quintile: ALL  (no vol filter — vol_q="ALL" disables Q5 gate)
//   - Horizon: 12 bars (time stop on the 12th bar close after entry)
//   - Catastrophic SL: −2 × vol20 × close × sqrt(20)  (not modelled here;
//     time-stop only on visualization)
//
// Equivalence: signal logic matches
//   strategies/hourly/price_shock_reversion_base.PriceShockReversionBase
//   .signal_mask_from_dataframe (see tests/test_pine_overlay_equivalence.py)
//
// BT stats (commit 63c7cf18, MASSIVE AUD_JPY_1h.parquet full history):
//   N=426 / WR=63.8% / Wilson_lo(95%)=0.592 / PF=2.54 / EV≈+32.25pip
//
// Status (2026-05-18): Phase B-1 Shadow.
//
// DO NOT TUNE pct / horizon / vol_q — they are pre-reg LOCK.
// =====================================================================
indicator("Price-Shock Rev AUD_JPY H1 LONG (ALL h=12)", overlay=true,
     max_lines_count=500, max_labels_count=500, max_boxes_count=500)

PERCENTILE   = 0.01
HORIZON_BARS = 12
VOL_Q        = "ALL"    // vol filter disabled
ROLLING_WIN  = 252
VOL20_WIN    = 20

log_ret  = math.log(close / close[1])
lower_thr = ta.percentile_linear_interpolation(log_ret[1], ROLLING_WIN, PERCENTILE * 100)
vol20    = ta.stdev(log_ret, VOL20_WIN, false)
q80      = ta.percentile_linear_interpolation(vol20[1], ROLLING_WIN, 80)
in_q5    = not na(vol20) and not na(q80) and vol20 > q80
vol_pass = VOL_Q == "ALL" or in_q5

shock_long = not na(log_ret) and not na(lower_thr) and (log_ret <= lower_thr) and vol_pass

threshold_price = close[1] * math.exp(lower_thr)
plot(threshold_price, title="Lower 1% threshold (next-bar close)",
     color=color.new(color.red, 0), style=plot.style_circles, linewidth=1)

// VOL_Q == "ALL" → no Q5 regime background by design
bgcolor(VOL_Q == "ALL" ? na : (in_q5 ? color.new(color.yellow, 90) : na), title="Q5 vol regime")

plotshape(shock_long, title="Shock LONG", style=shape.triangleup,
     location=location.belowbar, color=color.new(color.green, 0),
     size=size.large, text="SHOCK")

var int entry_bar = na
bool exit_due = not na(entry_bar) and (bar_index - entry_bar) >= HORIZON_BARS
if shock_long and na(entry_bar)
    entry_bar := bar_index
if exit_due
    label.new(bar_index, high, "EXIT h=12",
         color=color.new(color.gray, 20), textcolor=color.white,
         style=label.style_label_down, size=size.small)
    entry_bar := na

plotshape(not na(entry_bar) and entry_bar == bar_index, title="Entry (next-bar open in prod)",
     style=shape.arrowup, location=location.belowbar,
     color=color.new(color.lime, 0), size=size.large)

var table info = table.new(position.top_right, 2, 7,
     bgcolor=color.new(color.black, 75), border_width=1)
if barstate.islast
    table.cell(info, 0, 0, "Pair / TF",      text_color=color.white, bgcolor=color.new(color.gray, 30))
    table.cell(info, 1, 0, "AUD_JPY H1",     text_color=color.white, bgcolor=color.new(color.gray, 30))
    table.cell(info, 0, 1, "Pre-reg",        text_color=color.white)
    table.cell(info, 1, 1, "pct=1% / h=12 / ALL", text_color=color.yellow)
    table.cell(info, 0, 2, "BT N / WR",      text_color=color.white)
    table.cell(info, 1, 2, "426 / 63.8%",    text_color=color.lime)
    table.cell(info, 0, 3, "Wilson_lo / PF", text_color=color.white)
    table.cell(info, 1, 3, "0.592 / 2.54",   text_color=color.lime)
    table.cell(info, 0, 4, "EV / trade",     text_color=color.white)
    table.cell(info, 1, 4, "+32.25 pip",     text_color=color.lime)
    table.cell(info, 0, 5, "Status",         text_color=color.white)
    table.cell(info, 1, 5, "Shadow (Phase B-1)", text_color=color.aqua)
    table.cell(info, 0, 6, "Source",         text_color=color.white)
    table.cell(info, 1, 6, "commit 35961351", text_color=color.gray)
