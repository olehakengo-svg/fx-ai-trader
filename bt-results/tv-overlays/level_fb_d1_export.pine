//@version=5
// level_failed_break_d1 (台帳 #18) per-event export — pre-reg FROZEN 2026-07-31
// knowledge-base/wiki/decisions/level-failed-break-d1-explore-prereg-2026-07-31.md
// pass-1 (PASS2=false): date|side|level|entry|mfe5 のみ (headroom gate, fwd-look 前)
// pass-2 (PASS2=true):  date|side|level|entry|net1|net3|net5|net10|mfe5|mae5
indicator("LFB_D1_EXPORT", overlay=true, max_bars_back=500)

bool PASS2 = input.bool(false, "pass2_full_export")

int LOOKBACK = 55
int CONFIRM = 3
int DEDUP = 10

int EXPLORE_START = timestamp("UTC", 2014, 1, 1, 0, 0)
int EXPLORE_END = timestamp("UTC", 2021, 12, 31, 23, 59)

float pip = syminfo.mintick * 10

// trading-day label = bar CLOSE day in NY tz (OANDA D1 opens Sun 21/22:00 UTC
// for the Monday bar — UTC open-time labeling marks every Monday as Sunday.
// Frozen QA assert (bars/week=5, wknd=0) caught this on first META read 2026-07-31;
// corrected BEFORE any forward-return look. True weekend stubs close Sat/Sun NY.)
int dow = dayofweek(time_close, "America/New_York")
bool isWknd = dow == dayofweek.saturday or dow == dayofweek.sunday
var int wkndCount = 0
if isWknd
    wkndCount += 1

var int firstTime = na
if bar_index == 0
    firstTime := time

float h55 = ta.highest(high[1], LOOKBACK)
float l55 = ta.lowest(low[1], LOOKBACK)

var float upLvl = na
var int upAge = 0
var float dnLvl = na
var int dnAge = 0
var int lastShortEvt = -99999
var int lastLongEvt = -99999

var array<float> evEntry = array.new_float()
var array<int> evDir = array.new_int()
var array<int> evBar = array.new_int()
var array<float> evLvl = array.new_float()
var array<string> evDate = array.new_string()
var array<bool> evDone = array.new_bool()
var array<string> rows = array.new_string()

if not isWknd and bar_index > LOOKBACK + 2
    // upside break state machine
    if na(upLvl)
        if close > h55
            upLvl := h55
            upAge := 0
    else
        upAge += 1
        if close < upLvl
            if bar_index - lastShortEvt > DEDUP and time >= EXPLORE_START and time <= EXPLORE_END
                array.push(evEntry, close)
                array.push(evDir, -1)
                array.push(evBar, bar_index)
                array.push(evLvl, upLvl)
                array.push(evDate, str.format_time(time, "yyyy-MM-dd", "UTC"))
                array.push(evDone, false)
                lastShortEvt := bar_index
            upLvl := na
        else if upAge >= CONFIRM
            upLvl := na
    // downside break state machine
    if na(dnLvl)
        if close < l55
            dnLvl := l55
            dnAge := 0
    else
        dnAge += 1
        if close > dnLvl
            if bar_index - lastLongEvt > DEDUP and time >= EXPLORE_START and time <= EXPLORE_END
                array.push(evEntry, close)
                array.push(evDir, 1)
                array.push(evBar, bar_index)
                array.push(evLvl, dnLvl)
                array.push(evDate, str.format_time(time, "yyyy-MM-dd", "UTC"))
                array.push(evDone, false)
                lastLongEvt := bar_index
            dnLvl := na
        else if dnAge >= CONFIRM
            dnLvl := na

// finalize events exactly once when 10 bars elapsed
int nEv = array.size(evBar)
if nEv > 0
    for i = 0 to nEv - 1
        if not array.get(evDone, i) and bar_index - array.get(evBar, i) == 10
            int dir = array.get(evDir, i)
            float entry = array.get(evEntry, i)
            float c1 = close[9]
            float c3 = close[7]
            float c5 = close[5]
            float c10 = close
            float net1 = dir * (c1 - entry) / pip
            float net3 = dir * (c3 - entry) / pip
            float net5 = dir * (c5 - entry) / pip
            float net10 = dir * (c10 - entry) / pip
            float hi5 = high[9]
            float lo5 = low[9]
            for o = 5 to 8
                hi5 := math.max(hi5, high[o])
                lo5 := math.min(lo5, low[o])
            float mfe5 = dir == 1 ? (hi5 - entry) / pip : (entry - lo5) / pip
            float mae5 = dir == 1 ? (entry - lo5) / pip : (hi5 - entry) / pip
            string base = array.get(evDate, i) + "|" + (dir == 1 ? "L" : "S") + "|" + str.tostring(array.get(evLvl, i), format.mintick) + "|" + str.tostring(entry, format.mintick)
            string row = PASS2 ? base + "|" + str.tostring(net1, "#.##") + "|" + str.tostring(net3, "#.##") + "|" + str.tostring(net5, "#.##") + "|" + str.tostring(net10, "#.##") + "|" + str.tostring(mfe5, "#.##") + "|" + str.tostring(mae5, "#.##") : base + "|" + str.tostring(mfe5, "#.##")
            array.push(rows, row)
            array.set(evDone, i, true)

var table t = table.new(position.top_right, 3, 100, bgcolor=color.new(color.white, 100))
if barstate.islast
    int n = array.size(rows)
    string meta = "META|" + syminfo.ticker + "|first=" + str.format_time(firstTime, "yyyy-MM-dd", "UTC") + "|last=" + str.format_time(time, "yyyy-MM-dd", "UTC") + "|bars=" + str.tostring(bar_index + 1) + "|wknd=" + str.tostring(wkndCount) + "|events=" + str.tostring(n) + "|pass2=" + str.tostring(PASS2) + "|lb=55|cf=3|dd=10"
    table.cell(t, 0, 0, meta, text_size=size.tiny, text_color=color.black)
    if n > 0
        for i = 0 to n - 1
            int idx = i + 1
            int col = idx / 99
            int r = idx % 99
            table.cell(t, col, r, array.get(rows, i), text_size=size.tiny, text_color=color.black)
